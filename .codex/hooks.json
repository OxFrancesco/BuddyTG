{
  "description": "Route interactive Codex approvals to the owner's Telegram bot.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$(git rev-parse --show-toplevel)/src/cli.ts\" hook permission",
            "timeout": 600,
            "statusMessage": "Waiting for Telegram approval"
          }
        ]
      }
    ]
  }
}
